# Copy to .env and fill in real values. Never commit .env.

# --- Required ---
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
SECRET_KEY=<long-random-string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=<your-groq-api-key>
# Comma-separated list allowed; no trailing slash
FRONTEND_URL=https://<your-app>.vercel.app

# --- Email via Brevo (invites / password reset). Without these, emails are skipped and logged. ---
BREVO_API_KEY=<your-brevo-api-key>
MAIL_FROM=<verified-sender@example.com>
MAIL_FROM_NAME=FWT App

# --- Optional ---
# GROQ_MODEL=openai/gpt-oss-20b

# Demo mode: secret that protects GET /internal/demo-reset (Vercel Cron sends it as a Bearer token)
# CRON_SECRET=<long-random-string>
# DEMO_USER_EMAIL=demo@fwt-demo.com
# DEMO_CLIENT_EMAIL=demo-client@fwt-demo.com

# AI chat daily caps (defaults shown)
# CHAT_USER_DAILY_CAP=200
# CHAT_CLIENT_DAILY_CAP=50
# LANDING_IP_DAILY_CAP=10
# LANDING_GLOBAL_DAILY_CAP=300
# CHAT_GLOBAL_DAILY_CAP=1000
